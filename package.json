{
  "name": "formpilot",
  "version": "1.1.0",
  "description": "One-click resume autofill — remembers every answer across Moka, Workday, BOSS, Greenhouse. 一键投简历，跨站复填，答过的问题不再重复。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "autofill",
    "form-filler",
    "resume",
    "resume-autofill",
    "job-application",
    "ats",
    "moka",
    "workday",
    "greenhouse",
    "boss",
    "form-memory",
    "profile",
    "wxt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wxt prepare && tsc --noEmit",
    "verify": "yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
